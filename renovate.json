{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    ":timezone(Europe/Oslo)",
    ":ignoreUnstable"
  ],
  "dependencyDashboard": false,
  "flux": {
    "managerFilePatterns": ["/^cluster/.+\\.ya?ml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/^cluster/.+\\.ya?ml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Versions the flux/kubernetes managers can't see, marked with '# renovate: datasource=<ds> depName=<name>' on the line above. For 'key: <depName>:<tag>' values (e.g. CNPG imageName) only the tag is captured",
      "managerFilePatterns": ["/^cluster/.+\\.ya?ml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\s*\\n\\s*[\\w.-]+:\\s*\"?(?:[^\\s\"]+:)?(?<currentValue>[^\\s\":]+)\"?"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}"
    }
  ],
  "packageRules": [
    {
      "description": "Only allow version-like Docker tags (1, 1.2, 1.2.3, v1.2.3.4, with optional -suffix)",
      "matchDatasources": ["docker"],
      "allowedVersions": "/^v?[0-9]+(\\.[0-9]+){0,3}([-.][0-9A-Za-z]+)*$/"
    }
  ],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "schedule": ["at any time"]
}
